# Copy to .env.local for local development. On Vercel: Settings -> Environment Variables.
# Both values come from Supabase: Project Settings -> API Keys / Data API.
# The publishable key (sb_publishable_...) is meant to be public; Row Level Security protects the data.
# Never put the secret key (sb_secret_...) here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
